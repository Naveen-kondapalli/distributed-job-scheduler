# Development-only Docker Compose defaults.
# Copy to .env if you want local overrides. Do not commit real secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
JWT_SECRET=change-this-development-secret-key-minimum-32-characters

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

GATEWAY_CONNECT_TIMEOUT_MS=3000
GATEWAY_RESPONSE_TIMEOUT=10s
GATEWAY_MAX_REQUEST_SIZE=1MB

EXECUTOR_HTTP_ALLOWED_HOSTS=jsonplaceholder.typicode.com
