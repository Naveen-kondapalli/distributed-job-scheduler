    {"type": "timeseries", "title": "Heartbeat failures", "gridPos": {"x": 0, "y": 12, "w": 6, "h": 4}, "targets": [{"expr": "sum(rate(scheduler_executor_heartbeat_total{result=\"failure\"}[5m]))", "legendFormat": "failure"}]},
