    {"type": "timeseries", "title": "Retry scheduled rate", "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4}, "targets": [{"expr": "sum by (failure_category) (rate(scheduler_executor_retry_scheduled_total[5m]))", "legendFormat": "{{failure_category}}"}]},
