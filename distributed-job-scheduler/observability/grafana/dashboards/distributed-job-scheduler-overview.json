    {"type": "stat", "title": "Service health", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "targets": [{"expr": "up{job=~\"api-gateway|job-service|watcher-service|executor-service\"}", "legendFormat": "{{job}} {{instance}}"}]},
    {"type": "timeseries", "title": "Job creation rate", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "targets": [{"expr": "sum by (schedule_type) (rate(scheduler_jobs_created_total[5m]))", "legendFormat": "{{schedule_type}}"}]},
    {"type": "timeseries", "title": "Watcher claimed jobs rate", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}, "targets": [{"expr": "sum by (schedule_type) (rate(scheduler_watcher_jobs_claimed_total[5m]))", "legendFormat": "{{schedule_type}}"}]},
    {"type": "timeseries", "title": "Outbox backlog", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}, "targets": [{"expr": "sum by (status) (scheduler_outbox_events{status=~\"PENDING|PROCESSING|FAILED\"})", "legendFormat": "{{status}}"}]},
    {"type": "timeseries", "title": "Outbox publish failures", "gridPos": {"x": 0, "y": 4, "w": 6, "h": 4}, "targets": [{"expr": "sum by (topic) (rate(scheduler_outbox_publish_total{result=\"failure\"}[5m]))", "legendFormat": "{{topic}}"}]},
